# Copia a .env si quieres, y expórtalo antes de arrancar el agente:
#   set -a; . ./.env; set +a
# (el agente lee variables de entorno; no carga el archivo .env por sí solo)

# URL del servidor Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Modelo descargado con `ollama pull`
OLLAMA_MODEL=gemma3:4b
# (opcional) segundos máximos de espera por respuesta de Ollama
# OLLAMA_TIMEOUT=120
